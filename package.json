{
  "name": "rat-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic TypeScript scaffold: Effect 4, XState 6 with @xstate/effect, Alchemy infra, varlock config, and a lint/typecheck fence that makes cheating uncomfortable.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "alchemy": "pnpm --filter @rat-stack/infra exec alchemy",
    "build": "turbo run build",
    "check": "varlock load && turbo run typecheck && ultracite check && oxfmt --check .",
    "cli": "turbo run build --filter=@rat-stack/cli && node apps/cli/dist/cli.js",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "mischief:smoke": "bash apps/mischief/scripts/smoke.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "infra:deploy": "pnpm --filter @rat-stack/infra deploy",
    "infra:destroy": "pnpm --filter @rat-stack/infra destroy",
    "infra:dev": "pnpm --filter @rat-stack/infra dev",
    "infra:plan": "pnpm --filter @rat-stack/infra plan",
    "prepare": "effect-tsgo patch && lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "24.13.6",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "varlock": "1.20.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
