{
  "name": "ts-cli-template",
  "version": "0.1.0",
  "description": "A strict, batteries-included TypeScript CLI template for Node.js.",
  "license": "MIT",
  "bin": {
    "ts-cli-template": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && ultracite check",
    "cli": "npm run build --silent && node dist/cli.js",
    "fix": "ultracite fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepack": "npm run build",
    "pretest": "npm run build --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.98",
    "effect": "4.0.0-beta.98",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.9",
    "@types/node": "24.13.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.24.0",
    "turbo": "2.10.5",
    "typescript": "7.0.2",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0"
}
