{
  "name": "@rat-stack/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "rat-stack": "./bin/rat-stack"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "pnpm run --silent build && node dist/cli.js",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.116",
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/core": "workspace:*",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
