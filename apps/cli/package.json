    "effect": "4.0.0-rc.115",
    "xstate": "6.0.0-alpha.58"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
