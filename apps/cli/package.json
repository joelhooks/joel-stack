{
  "name": "@joel-stack/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "joel-stack": "./bin/joel-stack"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
