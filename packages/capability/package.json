    },
    "./code-mode": {
      "types": "./src/code-mode.ts",
      "import": "./dist/code-mode.js",
      "default": "./dist/code-mode.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
