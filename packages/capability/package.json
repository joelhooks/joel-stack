{
  "name": "@rat-stack/capability",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
