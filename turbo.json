{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#lint": {
      "dependsOn": ["@rat-stack/mischief#generate"],
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["typecheck", "//#lint", "//#typecheck-scripts"],
      "outputs": []
    },
    "@rat-stack/mischief#generate": {
      "cache": false,
      "outputs": ["src/bundled-content.generated.ts"]
    },
    "@rat-stack/mischief#typecheck": {
      "dependsOn": ["@rat-stack/mischief#generate", "^typecheck"],
      "outputs": []
    },
    "@rat-stack/mischief#build": {
      "dependsOn": ["@rat-stack/mischief#generate", "^build"],
      "outputs": ["dist/**"]
    },
    "@rat-stack/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  }
}
